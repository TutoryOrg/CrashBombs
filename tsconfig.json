{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@src/*": ["./src/*"],
			"@assets/*": ["./assets/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@store/*": ["./src/store/*"],
			"@themes/*": ["./src/themes/*"],
			"@screens/*": ["./src/screens/*"],
			"@components/*": ["./src/components/*"],
			"@translations/*": ["./src/translations/*"]
		}
	}
}
